<Project Sdk="Microsoft.NET.Sdk">
<!--    <Import Project="$(MSBuildThisFileDirectory)/../Directory.Build.props" />-->

    <!-- General Package Properties
         (Authors/Copyright/RepositoryUrl come from the common Directory.Build.props) -->
    <PropertyGroup>
        <PackageId>MaterialFilterOverlay</PackageId>
        <Version>0.0.4</Version>
        <TargetFramework>net48</TargetFramework>
    </PropertyGroup>


    <!-- Build Properties -->
    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>default</LangVersion>
        <AssemblyName>$(PackageId)</AssemblyName>
        <RootNamespace>$(PackageId)</RootNamespace>
        <IsMod>true</IsMod>
        <GenerateMetadata>true</GenerateMetadata>
<!--        Enable if added external dll like PLib -->
        <IsPacked>true</IsPacked>
    </PropertyGroup>


    <!-- Mod Info -->
    <PropertyGroup>
        <ModName>Material Filter Overlay</ModName>
        <ModDescription>Replaces the vanilla «Схема материалов» (TileMode) legend filter panel with a custom legend panel.</ModDescription>
        <!-- Workshop publishedfileid: 0 = первая публикация; после — реальный id -->
        <WorkshopItemId>0</WorkshopItemId>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <OutDir>bin</OutDir>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\UtilLibs\UtilLibs.csproj" />
    </ItemGroup>

    <!-- uGUI reference: this mod handles row clicks with
         IPointerClickHandler/PointerEventData and adds raycast-target Images.
         The game's UI (PLib) is built on uGUI, so UnityEngine.UI is loaded
         at runtime; it is not referenced transitively by the other refs. -->
    <ItemGroup>
        <Reference Include="UnityEngine.UI">
            <HintPath>$(GameLibsFolder)/UnityEngine.UI.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <!-- TextAnchor (label TextAlignment) lives in the TextRendering module. -->
        <Reference Include="UnityEngine.TextRenderingModule">
            <HintPath>$(GameLibsFolder)/UnityEngine.TextRenderingModule.dll</HintPath>
            <Private>False</Private>
        </Reference>
    </ItemGroup>


</Project>
