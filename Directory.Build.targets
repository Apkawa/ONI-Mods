<?xml version="1.0" encoding="utf-8" ?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

<!--
	<Target Name="Debug Vars" AfterTargets="PreBuildEvent">
		<Exec Command="echo $(GameLibsFolder) $(MSBuildThisFileDirectory)" />
		<Exec Command="echo $(MSBuildThisFileDirectory)" />
	</Target>
-->

	<Target Name="Clean" BeforeTargets="PreBuildEvent">
<!--		<Exec Command="echo $(TargetDir)" />-->
		<Message Text="### Start Clean before build"
				 Importance="high" />
		<RemoveDir Directories="$(TargetDir)" />

		<Message Text="### Finished Clean before build"
				 Importance="high" />
	</Target>

	<!--Write mod.yaml file-->
	<Target Name="GenerateModYaml" BeforeTargets="PrepareForRun" Condition="'$(DoNotBuildAsMod)' != 'true'">
		<!--Configuration-dependent title/staticID: the dev build advertises itself
		     with a [DEBUG] title and a _dev staticID so its folder and the mod
		     manager entry are unambiguous; release keeps the plain values.-->
		<ItemGroup>
			<ModLines Include="title: '$(ModName)'" Condition="'$(Configuration)' == 'Release'"/>
			<ModLines Include="title: '$(ModName) [DEBUG]'" Condition="'$(Configuration)' != 'Release'"/>
			<ModLines Include="description: &quot;$([System.String]::Copy('$(ModDescription)').Replace('&quot;', '\&quot;'))&quot;"/>
			<ModLines Include="staticID: $(AssemblyName)" Condition="'$(Configuration)' == 'Release'"/>
			<ModLines Include="staticID: $(AssemblyName)_dev" Condition="'$(Configuration)' != 'Release'"/>
			<!--<ModLines Include="steamID: $(SteamId)" Condition="'$(SteamId)' != ''"/>--> <!--Causes recoverable parse errors :/-->
		</ItemGroup>
		<WriteLinesToFile File="$(TargetDir)/mod.yaml" Overwrite="true" Lines="@(ModLines)"/>
    <ItemGroup>
      <FileWrites Include="$(TargetDir)/mod.yaml" Condition="Exists('$(TargetDir)/mod.yaml')"/>
    </ItemGroup>
	</Target>
	<!--Write mod_info.yaml file-->
	<Target Name="GenerateModInfoYaml" BeforeTargets="PrepareForRun" Condition="'$(DoNotBuildAsMod)' != 'true'">
		<ItemGroup>
			<ModInfoLines Include="minimumSupportedBuild: $(MinimumSupportedBuild)"/>
			<ModInfoLines Include="version: $(Version)"/>
			<ModInfoLines Include="APIVersion: 2"/>
			<!-- The game still reads this (KMod.Mod: converted to requiredDlcIds/forbiddenDlcIds),
			     but logs a deprecation devlog warning; modern replacement is the two
			     *DlcIds fields below. -->
			<ModInfoLines Include="supportedContent: $(SupportedContent)" Condition="'$(SupportedContent)' != ''"/>
			<ModInfoLines Include="requiredDlcIds:" Condition="'$(RequiredDlcIds)' != ''"/>
			<ModInfoLines Include="$([System.String]::Copy('$(RequiredDlcIds)').Insert(0,' - ').Replace(',','%0a- '))" Condition="'$(RequiredDlcIds)' != ''"/>
			<ModInfoLines Include="forbiddenDlcIds:" Condition="'$(ForbiddenDlcIds)' != ''"/>
			<ModInfoLines Include="$([System.String]::Copy('$(ForbiddenDlcIds)').Insert(0,' - ').Replace(',','%0a- '))" Condition="'$(ForbiddenDlcIds)' != ''"/>
		</ItemGroup>
		<WriteLinesToFile File="$(TargetDir)/mod_info.yaml" Overwrite="true" Lines="@(ModInfoLines)"/>
    <ItemGroup>
      <FileWrites Include="$(TargetDir)/mod_info.yaml" Condition="Exists('$(TargetDir)/mod_info.yaml')"/>
    </ItemGroup>
	</Target>

	<!--Convert the mod's README.md into Steam BBCode (README.txt) via the
	     markdown_to_bbcodesteam CLI from the Converter.MarkdownToBBCodeNM.Tool package
	     (version kept in sync with Directory.Build.props).-->
	<Target Name="GenerateReadmeBbcode" AfterTargets="Build"
			Condition="'$(Configuration)' == 'Release' and '$(DoNotBuildAsMod)' != 'true' and Exists('$(ProjectDir)README.md')"
	>
		<PropertyGroup>
			<ReadmeBbcodePath>$(TargetDir)README.txt</ReadmeBbcodePath>
			<!-- Tools folder of the Converter.MarkdownToBBCodeNM.Tool package (keep in
			     sync with the version in Directory.Build.props) -->
			<BbcodeToolPath>$([System.IO.Path]::Combine('$(NuGetPackageRoot)', 'converter.markdowntobbcodenm.tool', '1.0.0.29', 'tools', 'net8.0', 'any', 'Converter.MarkdownToBBCodeNM.Tool.dll'))</BbcodeToolPath>
		</PropertyGroup>
		<Exec Command="dotnet &quot;$(BbcodeToolPath)&quot; -i &quot;$(ProjectDir)README.md&quot; -o &quot;$(ReadmeBbcodePath)&quot;" />
		<Message Text="[MSBuild] Generated README.txt (BBCode) at $(ReadmeBbcodePath)" Importance="high" />
	</Target>


	<!--Merges all dlls in the output folder into a single dll.
	     Drives the cross-platform dotnet-ilrepack CLI (local tool manifest in
	     .config/dotnet-tools.json). The legacy ILRepack.Lib.MSBuild.Task task assembly
	     only loads under full .NET Framework MSBuild (MSB4062 under the dotnet SDK:
	     missing Microsoft.Build.Utilities.v4.0). -->
	<Target Name="ILRepack" AfterTargets="Build" Condition="'$(IsPacked)' == 'true'">
		<ItemGroup>
			<RepackAssemblies
					Include="$(TargetDir)\*.dll"
					Exclude="$(TargetPath); **/*Harmony.dll; **/Splat.dll; **/Assembly-*; **_public.dll ;**Newtonsoft.Json;**/System.*; **/Microsoft.*; **/Unity*" />
		</ItemGroup>
		<PropertyGroup>
			<RepackAssemblyArgs>@(RepackAssemblies->'&quot;%(FullPath)&quot;', ' ')</RepackAssemblyArgs>
			<!-- Tools folder of the dotnet-ilrepack package (keep in sync with the
			     version in Directory.Build.props) -->
			<IlrepackToolPath>$([System.IO.Path]::Combine('$(NuGetPackageRoot)', 'dotnet-ilrepack', '2.0.45', 'tools', 'net8.0', 'any', 'ILRepackTool.dll'))</IlrepackToolPath>
		</PropertyGroup>
		<Exec Command="dotnet &quot;$(IlrepackToolPath)&quot; /out:&quot;$(TargetPath)&quot; &quot;$(TargetPath)&quot; $(RepackAssemblyArgs) /lib:&quot;$(GameLibsFolder)&quot;" />
	</Target>

	<!--Copies the mod dll, the two yaml files and everything inside the ModAssets folder to the target mod folder-->
  <PropertyGroup>
		<ModBuildFlavor Condition="'$(Configuration)' == 'Release'">release</ModBuildFlavor>
		<ModBuildFlavor Condition="'$(Configuration)' != 'Release'">dev</ModBuildFlavor>
		<ModTargetFolder Condition="'$(GameLibsFolder)' != '../Lib'">$(ModFolder)\$(TargetName)_$(ModBuildFlavor)\</ModTargetFolder>
		<ModTargetFolder Condition="'$(GameLibsFolder)' == '../Lib'">../Builds\$(TargetName)</ModTargetFolder>
	</PropertyGroup>

	<Target Name="CopyModsToDevFolder" AfterTargets="ILRepack" Condition="'$(DoNotBuildAsMod)' != 'true'">

		<Message Text="Executing CopyDLLs task" Importance="High" />

		<ItemGroup>
			<ModAssets
				Include = ".\ModAssets\**\*.*"
				Exclude = ".\**\*.afphoto;.\**\*.mo;.\**\*.afphoto~lock~"
				/>
		</ItemGroup>

		<Copy
		  SourceFiles="
			$(TargetDir)$(TargetName).dll;
			$(TargetDir)$(TargetName).pdb;
			$(TargetDir)mod.yaml;
			$(TargetDir)mod_info.yaml;
		  "

		  DestinationFolder="$(ModTargetFolder)"/>

		<Copy
		  SourceFiles="
			$(TargetDir)README.txt;
		  "
		  DestinationFolder="$(ModTargetFolder)"
			Condition="Exists('$(TargetDir)README.txt')"
		/>

		<Message Text="Copy ModAssets to $(ModTargetFolder)" Importance="High"></Message>

		<Copy SourceFiles="@(ModAssets)"
			DestinationFolder="$(ModTargetFolder)\%(RecursiveDir)"
			SkipUnchangedFiles="false"
			Condition="'$(GameLibsFolder)' == '../Lib' Or '$(SkipAssetClone)' != 'true'"/>

		<Message Text="Copied build files" Importance="High" />

	</Target>


	<!--Write workshop_build.vdf file-->
	<Target Name="GenerateSteamVdf" AfterTargets="GenerateReadmeBbcode"
			Condition="'$(Configuration)' == 'Release' and '$(DoNotBuildAsMod)' != 'true' and Exists('$(ProjectDir)README.md')">
		<!-- Steam workshop local-publish config (steamcmd / Oxygen Not Included Uploader input).
		     The game never reads this file. -->
		<PropertyGroup>
			<ReadmePath>$(TargetDir)README.txt</ReadmePath>
			<VdfOutputPath>$(TargetDir)workshop_build.vdf</VdfOutputPath>
			<PreviewName Condition="'$(PreviewName)' == ''">preview.png</PreviewName>
			<WorkshopVisibility Condition="'$(WorkshopVisibility)' == ''">2</WorkshopVisibility>
			<WorkshopAppId Condition="'$(WorkshopAppId)' == ''">457140</WorkshopAppId>
		</PropertyGroup>

		<PropertyGroup>
			<!-- Read the whole README directly so the description keeps its raw newlines
			     (a multi-line quoted string is the proven working form for VDF files),
			     then escape quotes for the VDF format. Not via @(ReadmeLines): expanding
			     an item list in a property joins the lines with ';' and percent-escapes
			     the content (e.g. '**' -> %2a%2a) in this MSBuild, which would corrupt
			     the VDF text. -->
			<SanitizedDescription>$([System.IO.File]::ReadAllText('$(ReadmePath)').Replace('"', '\"').Trim())</SanitizedDescription>

			<VdfContent>
"workshopitem"
{
	"appid"		"$(WorkshopAppId)"
	"publishedfileid"	"$(WorkshopItemId)"
	"contentfolder"	"$(ModTargetFolder.TrimEnd('/').TrimEnd('\'))"
	"previewfile"	"$(ProjectDir)$(PreviewName)"
	"visibility"	"$(WorkshopVisibility)"
	"title"		"$(ModName)"
	"description"	"$(SanitizedDescription)"
	"changenote"	"Version: $(Version)"
}
			</VdfContent>
		</PropertyGroup>

		<!-- No Encoding attribute: MSBuild 17 (dotnet SDK) defaults WriteLinesToFile to
		     UTF-8 without BOM. (The classic-MSBuild string value 'UTF8NoBOM' is rejected
		     here as MSB3098; 'UTF-8' would emit a BOM, which can break the VDF parser.) -->
		<WriteLinesToFile File="$(VdfOutputPath)" Lines="$(VdfContent)" Overwrite="true" />
		<Message Text="[MSBuild] Generated workshop_build.vdf at $(VdfOutputPath)" Importance="high" />
	</Target>



	<!--
		Legacy publicise targets removed: game dlls are now publicized in-process by
		BepInEx.AssemblyPublicizer.MSBuild (see <Publicize> metadata on the references
		in Directory.Build.props). The PublicisedAssembly folder is no longer needed.
	-->

	<ItemGroup>
		<GameRefAssemblies Include="
					    Assembly-CSharp.dll;
					    Assembly-CSharp-firstpass.dll;
					    0Harmony.dll;
					    FMODUnity.dll;
					    Newtonsoft.Json.dll;
					    UnityEngine.dll;
					    UnityEngine.CoreModule.dll;
					    UnityEngine.ImageConversionModule.dll;
					    UnityEngine.AssetBundleModule.dll;
					    UnityEngine.PhysicsModule.dll;
					    UnityEngine.Physics2DModule.dll;
					    UnityEngine.ParticleSystemModule.dll;
					    UnityEngine.InputLegacyModule.dll;
					    Unity.TextMeshPro.dll;
					    UnityEngine.TextRenderingModule.dll;
					    UnityEngine.UI.dll;
					    UnityEngine.UIModule.dll;
					    UnityEngine.UnityWebRequestModule.dll;
					    Ionic.Zip.dll;
					    Newtonsoft.Json.dll;
					    com.rlabrecque.steamworks.net.dll;
					    netstandard.dll
					    " />
		<RefAssemblies Include="../PublicisedAssembly/*.dll; @(GameRefAssemblies->'$(GameLibsFolder)\%(Identity)')" />
	</ItemGroup>
	<Target Name="GenerateRefAssemblies"
			Inputs="@(RefAssemblies)"
			Outputs="@(RefAssemblies->'../Lib/%(Filename)%(Extension)')"
			AfterTargets="Publicise"
			BeforeTargets="BeforeResolveReferences"
			Condition="'$(GameLibsFolder)' != '../Lib' and '$(RefasmerInstalled)' != '0' and '$(IsMod)' == 'true'">

		<!--Workaround for paths containing spaces, e.g. "Program Files (x86)"-->
		<!--For some reason, adding the quotes to GameLibsFolder does not work-->
		<ItemGroup>
			<RefAsmerArguments Include="@(RefAssemblies -> '&quot;%(FullPath)&quot;', ' ')" />
		</ItemGroup>

		<Exec Command="Refasmer -v -O ../Lib --all -c @(RefAsmerArguments)" />
	</Target>


</Project>
